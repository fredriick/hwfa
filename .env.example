# Hwfa local secrets — TEMPLATE.
#
# Copy to `.env.local` (gitignored) and fill in ROTATED values. Never commit real
# keys. Nothing here is loaded automatically yet; the services read these when the
# integrations land. DISCOVERY_DEV must NEVER be set in production.

# --- Africa's Talking (SMS OTP) ---
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# --- Cloudflare R2 (encrypted media storage) ---
R2_ACCOUNT_ID=
R2_BUCKET=hwfa-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Firebase / FCM (push) ---
# google-services.json goes in apps/mobile/android/app/ (gitignored).
# The server needs a service-account JSON; point to its path here.
FCM_SERVICE_ACCOUNT_JSON=
